{
  "name": "anachat",
  "private": true,
  "version": "3.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:web",
    "dev:backend": "npm --workspace @anachat/backend run dev",
    "dev:web": "npm --workspace @anachat/web run dev",
    "dev:admin": "npm --workspace @anachat/admin run dev",
    "build": "npm run build:backend && npm run build:web && npm run build:admin",
    "build:backend": "npm --workspace @anachat/backend run build",
    "build:web": "npm --workspace @anachat/web run build",
    "build:admin": "npm --workspace @anachat/admin run build",
    "lint": "npm run lint:backend && npm run lint:web",
    "lint:backend": "npm --workspace @anachat/backend run lint",
    "lint:web": "npm --workspace @anachat/web run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
